{
  "name": "vscode-git-utils",
  "version": "1.3.0",
  "displayName": "Git Extras",
  "description": "Extra Git commands for VS Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/mskelton/vscode-git-extras"
  },
  "license": "ISC",
  "publisher": "mskelton",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "category": "Git Extras",
        "title": "Push",
        "command": "git-extras.push"
      },
      {
        "category": "Git Extras",
        "title": "Pull",
        "command": "git-extras.pull"
      },
      {
        "category": "Git Extras",
        "title": "Sync",
        "command": "git-extras.sync"
      },
      {
        "category": "Git Extras",
        "title": "Append",
        "command": "git-extras.append"
      },
      {
        "category": "Git Extras",
        "title": "Force Push with Lease",
        "command": "git-extras.push-force-with-lease"
      },
      {
        "category": "Git Extras",
        "title": "Checkout Default Branch",
        "command": "git-extras.checkout-default-branch"
      },
      {
        "category": "Git Extras",
        "title": "Checkout File from Default Branch",
        "command": "git-extras.checkout-file-from-default-branch"
      },
      {
        "category": "Git Extras",
        "title": "Copy Remote URL",
        "command": "git-extras.copy-remote-url"
      },
      {
        "category": "Git Extras",
        "title": "Open Blame",
        "command": "git-extras.open-blame"
      }
    ],
    "configuration": {
      "title": "Git Extras",
      "properties": {
        "git-extras.remotes": {
          "type": "array",
          "default": [],
          "description": "Custom remote URL templates for hosts not natively supported. GitHub is built in. Templates support ${1}, ${2}, ... for regex capture groups, and ${sha}, ${file}, ${line} for file/blame URLs.",
          "items": {
            "type": "object",
            "required": [
              "regex",
              "repo",
              "file",
              "blame"
            ],
            "properties": {
              "regex": {
                "type": "string",
                "description": "Regex matched against the remote URL. Capture groups are referenced as ${1}, ${2}, ..."
              },
              "repo": {
                "type": "string",
                "description": "URL template for the repository root."
              },
              "file": {
                "type": "string",
                "description": "URL template for a file at a commit. Supports ${sha}, ${file}, ${line}."
              },
              "blame": {
                "type": "string",
                "description": "URL template for blame at a commit. Supports ${sha}, ${file}, ${line}."
              }
            }
          }
        }
      }
    }
  },
  "main": "./out/extension.js",
  "icon": "resources/icon.png",
  "files": [
    "out/**/*",
    "resources/**/*.png",
    "LICENSE"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "devDependencies": {
    "@mskelton/eslint-config": "^9.2.0",
    "@types/node": "^22.15.17",
    "@types/vscode": "^1.60.0",
    "eslint": "^9.29.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
